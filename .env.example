# SONIA — environment variables

# ============================================================================
# 1. compose — las lee docker compose, ningun proceso
# ============================================================================

# --- postgres ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ============================================================================
# 2. compartidas — las leen el nucleo y el cerebro por igual
# ============================================================================

DATABASE_URL=
ENVIRONMENT=
LOG_LEVEL=info
DB_POOL_MIN_SIZE=
DB_POOL_MAX_SIZE=

# ============================================================================
# 3. contrato core <-> brain — el nucleo llamando al cerebro
# ============================================================================

BRAIN_INTERNAL_TOKEN=
BRAIN_BASE_URL=
BRAIN_TIMEOUT_MS=10000
BRAIN_PREVIEW_TIMEOUT_MS=3000

# ============================================================================
# 4. core (Go) — las lee el nucleo al arrancar
# ============================================================================

# --- servidor ---
CORE_HTTP_ADDR=:8080

# --- el turno ---
TURN_MAX_RETRIES=3
TURN_RETRY_BACKOFF_MS=250
TURN_BUDGET_MS=30000

# --- el temporizador del turno (F10, ADR-0041) ---
TURN_BATCH_WINDOW_MS=10000
TURN_POLL_INTERVAL_MS=1000
TURN_BATCH_MAX_MESSAGES=10
TURN_BATCH_MAX_DURATION_MS=60000
TURN_POLL_LIMIT=10

# --- autenticacion de operadores ---
JWT_SECRET=
JWT_TTL_MS=43200000

# --- cifrado en reposo ---
ENCRYPTION_KEY=

# --- documentos de F06 (ADR-0064, ADR-0069) ---
# La llave de los documentos: 32 bytes en base64, distinta de ENCRYPTION_KEY. La tienen el nucleo y el worker.
DOCUMENT_ENCRYPTION_KEY=
FIREBASE_STORAGE_BUCKET=
# Ruta dentro del contenedor: el archivo va en secrets/ y compose lo monta en /run/secrets.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
STORAGE_TIMEOUT_MS=120000

# --- canal de WhatsApp (Meta Cloud API) ---
META_GRAPH_BASE_URL=https://graph.facebook.com
META_API_VERSION=v21.0
WHATSAPP_TIMEOUT_MS=5000

# ============================================================================
# 5. brain (Python) — las lee el cerebro al arrancar
# ============================================================================

# --- servidor ---
BRAIN_HTTP_HOST=
BRAIN_HTTP_PORT=

# --- proveedores de LLM ---
COHERE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_REFUSAL_FALLBACK=true
LLM_TIMEOUT_SECONDS=8
REWRITER_LLM_PROVIDER=
REWRITER_LLM_MODEL=
REWRITER_TIMEOUT_SECONDS=
REWRITER_MAX_RETRIES=

# --- worker de ingesta de F06 (ADR-0064, ADR-0067, ADR-0071, ADR-0072) ---
# El Qdrant del compose, que no pide clave. Se cambia solo para apuntar a otro (por ejemplo, el de produccion), con su clave.
# Vacia, el compose usa este mismo valor.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=30
VOYAGE_API_KEY=
VOYAGE_TIMEOUT_SECONDS=30
STORAGE_TIMEOUT_SECONDS=120
DESCRIPTION_TIMEOUT_SECONDS=60
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_LOCK_TIMEOUT_SECONDS=900

# --- token budget ---
LLM_CONTEXT_WINDOW_TOKENS=
PROMPT_SAFETY_MARGIN_TOKENS=
PROMPT_HISTORY_MAX_TURNS=20
TOKEN_COUNT_MODE=estimate
RULES_DIR=rules

# ============================================================================
# 6. solo comandos — no las lee ningun arranque, solo un `make` (regla 3)
# ============================================================================

# --- semilla del admin (`make seed-admin`) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_ACCOUNT_NAME=SONIA

# --- conectar un numero (`make connect-inbox`) ---
CONNECT_INBOX_PHONE_NUMBER_ID=
CONNECT_INBOX_ACCESS_TOKEN=
CONNECT_INBOX_APP_SECRET=

# ============================================================================
# 7. solo desarrollo y test — nada de esto vive en produccion
# ============================================================================

# --- pgadmin (deploy/docker-compose.dev.yml) ---
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# --- DB Test ---
SONIA_TEST_DATABASE_URL=

# --- los dos dobles ---
WHATSAPP_USE_DOUBLE=false
LLM_USE_DOUBLE=false
# Un fake-gcs-server en lugar de Firebase: solo en development y test (ADR-0070).
STORAGE_EMULATOR_HOST=
# Embeddings de mentira en lugar de Voyage: solo en development y test (ADR-0071).
EMBEDDINGS_USE_DOUBLE=false
