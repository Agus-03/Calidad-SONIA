# SONIA — environment variables

# --- postgres ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- pgadmin (solo desarrollo: deploy/docker-compose.dev.yml) ---
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# --- shared ---
DATABASE_URL=
ENVIRONMENT=
LOG_LEVEL=info
DB_POOL_MIN_SIZE=
DB_POOL_MAX_SIZE=

# --- core <-> brain ---
BRAIN_INTERNAL_TOKEN=

# --- core (Go) ---
CORE_HTTP_ADDR=:8080
BRAIN_BASE_URL=
BRAIN_TIMEOUT_MS=10000
BRAIN_PREVIEW_TIMEOUT_MS=3000
TURN_MAX_RETRIES=3
TURN_RETRY_BACKOFF_MS=250
# Acota cuanto vive una goroutine de turno, y con eso cuanto espera un despliegue antes de cortar (ADR-0029).
TURN_BUDGET_MS=30000

# --- autenticacion de operadores ---
# Firma el token de sesion: si falta o mide menos de 32 bytes el nucleo no arranca, y rotarlo desloguea a todos (ADR-0030).
JWT_SECRET=
# 12 h: la sesion sobrevive una jornada larga y vence fuera del horario de atencion, nunca en medio de una conversacion.
JWT_TTL_MS=43200000

# --- semilla del admin (solo `make seed-admin`, nunca al arrancar: regla 3) ---
# Las lee el sembrador y no el arranque: vacias, el nucleo levanta igual y lo unico que falla es `make seed-admin`.
SEED_ADMIN_EMAIL=
# Se hashea con bcrypt al sembrar, asi que la unica copia en claro es esta linea: cambiarla despues del primer login.
SEED_ADMIN_PASSWORD=
# Nombre de la cuenta que se crea si la base todavia no tiene ninguna: instalar es crear la cuenta y su primer admin.
SEED_ADMIN_ACCOUNT_NAME=SONIA

# --- cifrado en reposo ---
# Base64 de 32 bytes crudos: si falta, no decodifica o no mide 32, el nucleo no arranca (ADR-0031).
# Perderla es perder los datos, no una contrasena que se resetea: entra en el procedimiento de respaldo.
ENCRYPTION_KEY=

# --- canal de WhatsApp (Meta Cloud API) ---
# El access token no esta aca: es de la bandeja y lo configura la pantalla de F29, porque una cuenta conecta varios numeros.
META_GRAPH_BASE_URL=https://graph.facebook.com
# Fijada y nunca flotante: Meta versiona el path, y una version sin fijar cambia el contrato sin un deploy.
META_API_VERSION=v21.0
WHATSAPP_TIMEOUT_MS=5000
# No sale a Meta: solo se admite con ENVIRONMENT en development o test, y en otro caso el proceso no arranca.
WHATSAPP_USE_DOUBLE=false

# --- brain (Python) ---
BRAIN_HTTP_HOST=
BRAIN_HTTP_PORT=

# --- proveedores de LLM ---
COHERE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_REFUSAL_FALLBACK=true
# Debajo de BRAIN_TIMEOUT_MS, que es lo que el nucleo espera por el turno entero.
LLM_TIMEOUT_SECONDS=8
# Responde texto enlatado: solo se admite con ENVIRONMENT en development o test, y en otro caso el proceso no arranca.
LLM_USE_DOUBLE=false
REWRITER_LLM_PROVIDER=
REWRITER_LLM_MODEL=
REWRITER_TIMEOUT_SECONDS=
REWRITER_MAX_RETRIES=

# --- token budget ---
LLM_CONTEXT_WINDOW_TOKENS=
PROMPT_SAFETY_MARGIN_TOKENS=
PROMPT_HISTORY_MAX_TURNS=20
# estimate | exact
TOKEN_COUNT_MODE=estimate
RULES_DIR=rules
