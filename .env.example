# SONIA — environment variables

# --- postgres ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- pgadmin (solo desarrollo: deploy/docker-compose.dev.yml) ---
# pgAdmin valida el dominio: .local y otros reservados los rechaza y el container no levanta.
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# --- shared ---
DATABASE_URL=
ENVIRONMENT=
LOG_LEVEL=info
DB_POOL_MIN_SIZE=
DB_POOL_MAX_SIZE=

# --- core <-> brain ---
BRAIN_INTERNAL_TOKEN=

# --- core (Go) ---
CORE_HTTP_ADDR=:
BRAIN_BASE_URL=
BRAIN_TIMEOUT_MS=10000
BRAIN_PREVIEW_TIMEOUT_MS=3000
TURN_MAX_RETRIES=3
TURN_RETRY_BACKOFF_MS=250

# --- brain (Python) ---
BRAIN_HTTP_HOST=
BRAIN_HTTP_PORT=
ANTHROPIC_API_KEY=
ANTHROPIC_REFUSAL_FALLBACK=true
REWRITER_LLM_PROVIDER=
REWRITER_LLM_MODEL=
REWRITER_TIMEOUT_SECONDS=
REWRITER_MAX_RETRIES=

# --- token budget ---
LLM_CONTEXT_WINDOW_TOKENS=
PROMPT_SAFETY_MARGIN_TOKENS=
PROMPT_HISTORY_MAX_TURNS=20
# estimate | exact
TOKEN_COUNT_MODE=estimate
RULES_DIR=rules
